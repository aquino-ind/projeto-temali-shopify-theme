{%- comment -%}
  Texto com os botões (i) do glossário. Nos campos de texto do editor, escreva [i:sca], [i:mole] etc.
  Termos: sca, mole, corpo, acidez, torra, arabica, notas, finalizacao, docura, suspensa, arara, colheita, terroir, graos.
  Preços (só em página de produto, passando p: product): {preco} {dois} {kit} {kit_de} {kit_un} {economia} {por_xicara}
  ({por_xicara} usa o parâmetro xic = número de xícaras do kit). Assim os textos acompanham o preço cadastrado.
  Uso: {% render 'tml-texto', t: section.settings.texto %}  ou  {% render 'tml-texto', t: texto, p: product, xic: 200 %}
{%- endcomment -%}
{%- assign saida = t -%}
{%- if p != blank and saida contains '{' -%}
  {%- assign v_kit = p.price | times: 3 -%}
  {%- assign v_un = v_kit | divided_by: 4.0 | round -%}
  {%- assign v_xic = 0 -%}
  {%- if xic > 0 -%}{%- assign v_xic = v_kit | times: 1.0 | divided_by: xic | round -%}{%- endif -%}
  {%- assign m_preco = p.price | money -%}
  {%- assign m_dois = p.price | times: 2 | money -%}
  {%- assign m_kit = v_kit | money -%}
  {%- assign m_kit_de = p.price | times: 4 | money -%}
  {%- assign m_kit_un = v_un | money -%}
  {%- assign m_xic = v_xic | money -%}
  {%- assign saida = saida | replace: '{preco}', m_preco | replace: '{economia}', m_preco | replace: '{dois}', m_dois -%}
  {%- assign saida = saida | replace: '{kit_de}', m_kit_de | replace: '{kit_un}', m_kit_un | replace: '{kit}', m_kit | replace: '{por_xicara}', m_xic -%}
{%- endif -%}
{%- if saida contains '[i:' -%}
  {%- assign termos = 'sca,mole,corpo,acidez,torra,arabica,notas,finalizacao,docura,suspensa,arara,colheita,terroir,graos,defeitos' | split: ',' -%}
  {%- for termo in termos -%}
    {%- assign marca = '[i:' | append: termo | append: ']' -%}
    {%- assign botao = '<button type="button" class="info" data-termo="' | append: termo | append: '">i</button>' -%}
    {%- assign saida = saida | replace: marca, botao -%}
  {%- endfor -%}
{%- endif -%}
{{- saida -}}
