<div class="tml">
  <section class="ass-montar" id="montar">
    <div class="wrap">
      <div class="centro reveal">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.titulo }}</h2>
        <p class="lead so-whats">{{ section.settings.texto }}</p>
        <p class="lead so-online">{{ section.settings.texto_online }}</p>
      </div>

      <div class="montador" data-assinatura data-whats="{{ settings.tml_whats_numero }}">
        <div class="montador-passos">
          <fieldset class="m-bloco">
            <legend><span>1</span>Quais cafés você quer receber?</legend>
            {%- for block in section.blocks -%}
              {%- assign p = block.settings.produto -%}
              {%- if p != blank -%}
                {%- comment -%} Variantes de grão e moído (o pagamento pelo site manda a variante escolhida) {%- endcomment -%}
                {%- assign v_grao = p.selected_or_first_available_variant.id -%}
                {%- assign v_moido = v_grao -%}
                {%- for v in p.variants -%}
                  {%- assign t = v.title | downcase -%}
                  {%- if t contains 'mo' -%}{%- assign v_moido = v.id -%}{%- else -%}{%- assign v_grao = v.id -%}{%- endif -%}
                {%- endfor -%}
                <div class="m-cafe {{ block.settings.estilo }}" data-cafe="{{ block.settings.nome }} {{ block.settings.peso }}" data-preco="{{ p.price | divided_by: 100.0 }}" {{ block.shopify_attributes }}>
                  {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 200 | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}
                  <div class="m-info">
                    <b>{{ block.settings.nome }}{% if block.settings.selo != blank %} <span class="m-novo">{{ block.settings.selo }}</span>{% endif %}</b>
                    <small>{{ block.settings.peso }} • {{ block.settings.notas }} • {{ p.price | money }}</small>
                  </div>
                  {%- comment -%} Uma linha por formato: dá para pedir grão e moído do mesmo café {%- endcomment -%}
                  <div class="m-linhas">
                    <div class="m-linha" data-formato="grão" data-variante="{{ v_grao }}">
                      <span>{% if v_moido == v_grao %}Quantidade{% else %}Grão{% endif %}</span>
                      <div class="m-qtd">
                        <button type="button" data-menos aria-label="Menos um {{ block.settings.nome }} em grão">−</button>
                        <output aria-live="polite">{{ block.settings.qtd }}</output>
                        <button type="button" data-mais aria-label="Mais um {{ block.settings.nome }} em grão">+</button>
                      </div>
                    </div>
                    {%- if v_moido != v_grao -%}
                    <div class="m-linha" data-formato="moído" data-variante="{{ v_moido }}">
                      <span>Moído</span>
                      <div class="m-qtd">
                        <button type="button" data-menos aria-label="Menos um {{ block.settings.nome }} moído">−</button>
                        <output aria-live="polite">0</output>
                        <button type="button" data-mais aria-label="Mais um {{ block.settings.nome }} moído">+</button>
                      </div>
                    </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
            {%- if section.settings.dica != blank -%}<p class="m-dica">{{ section.settings.dica }}</p>{%- endif -%}
          </fieldset>

          <fieldset class="m-bloco">
            <legend><span>2</span>De quanto em quanto tempo?</legend>
            <div class="m-freq">
              <label class="opcao"><input type="radio" name="freq" value="Mensal" checked><span class="radio"></span><span class="opcao-txt"><b>Mensal</b><small>Uma entrega por mês</small></span></label>
              <label class="opcao"><input type="radio" name="freq" value="Bimestral"><span class="radio"></span><span class="opcao-txt"><b>Bimestral</b><small>A cada 2 meses</small></span></label>
              <label class="opcao"><input type="radio" name="freq" value="Trimestral"><span class="radio"></span><span class="opcao-txt"><b>Trimestral</b><small>A cada 3 meses</small></span></label>
            </div>
          </fieldset>
        </div>

        <aside class="m-resumo" aria-label="Resumo da assinatura">
          <span class="eyebrow">Sua assinatura</span>
          <ul data-resumo-itens></ul>
          <dl>
            <div><dt>Frequência</dt><dd data-resumo-freq>Mensal</dd></div>
            <div class="m-total"><dt>Cafés por entrega</dt><dd data-resumo-total></dd></div>
            <div class="m-desconto" data-resumo-desconto hidden><dt>Assinante</dt><dd></dd></div>
            <div><dt>Frete</dt><dd class="m-gratis" data-resumo-frete>Grátis</dd></div>
            <div class="m-total so-online"><dt>Valor por entrega</dt><dd data-resumo-valor></dd></div>
          </dl>
          <p class="m-obs so-whats">{{ section.settings.obs }}</p>
          <p class="m-obs so-online">{{ section.settings.obs_online }}</p>
          <div class="m-pagar" data-online hidden>
            <p class="m-troca" data-troca hidden>{{ section.settings.troca_texto }}</p>
            <label class="m-campo"><span>Seu nome</span><input name="nome" autocomplete="name" required></label>
            <label class="m-campo"><span>WhatsApp com DDD</span><input name="whatsapp" type="tel" inputmode="tel" autocomplete="tel" placeholder="(11) 98765-4321" required></label>
            <label class="m-campo"><span>E-mail <small>(opcional)</small></span><input name="email" type="email" autocomplete="email"></label>
            <button type="button" class="btn btn-bloco" data-pagar>{% render 'tml-icone', nome: 'cadeado' %} Assinar com cartão</button>
            <p class="micro">{{ section.settings.pagar_micro }}</p>
            <p class="m-ou">ou, se preferir conversar antes</p>
          </div>
          <a href="#" class="btn btn-bloco btn-whats" data-assinar target="_blank" rel="noopener">{% render 'tml-icone', nome: 'whats' %} Assinar pelo WhatsApp</a>
          <p class="m-aviso" data-aviso role="alert" hidden>Escolha pelo menos um café.</p>
          <p class="micro" style="text-align:center">Atendimento humano: {{ settings.tml_whats_horario }}</p>
        </aside>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Montador da assinatura",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Monte sua assinatura" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Do seu jeito, no seu ritmo" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Escolha abaixo e clique em “Assinar pelo WhatsApp”. A mensagem já vai pronta." },
    { "type": "inline_richtext", "id": "dica", "label": "Dica de consumo", "default": "<b>Quanto café eu preciso?</b> Cada xícara usa cerca de 10g. Quem toma 2 xícaras por dia gasta uns 600g por mês, ou seja, 1 Clássico e 1 Arara." },
    { "type": "text", "id": "obs", "label": "Observação sobre o valor", "default": "Valor dos cafés pelo preço do site. O valor final e a forma de pagamento são confirmados no WhatsApp." },
    { "type": "header", "content": "Assinatura pelo site (ligada no Temalli CRM)" },
    { "type": "textarea", "id": "texto_online", "label": "Texto", "default": "Escolha os cafés e a frequência e assine com cartão. Em Minhas assinaturas você troca ou cancela quando quiser." },
    { "type": "text", "id": "obs_online", "label": "Observação sobre o valor", "default": "Valor de cada entrega, já com o desconto de assinante. As próximas entregas são cobradas no mesmo cartão." },
    { "type": "text", "id": "pagar_micro", "label": "Texto abaixo do botão", "default": "Pagamento seguro pelo Asaas." },
    { "type": "text", "id": "troca_texto", "label": "Aviso de troca", "default": "Você está trocando a sua assinatura atual. Quando o pagamento desta for aprovado, a atual é cancelada sozinha." }
  ],
  "blocks": [ { "type": "cafe", "name": "Café", "settings": [
    { "type": "product", "id": "produto", "label": "Produto" },
    { "type": "text", "id": "nome", "label": "Nome", "default": "Temalli Clássico" },
    { "type": "text", "id": "peso", "label": "Peso", "default": "500g" },
    { "type": "text", "id": "notas", "label": "Notas", "default": "caramelo, chocolate, frutas" },
    { "type": "text", "id": "selo", "label": "Selo (ex.: Novo)" },
    { "type": "select", "id": "estilo", "label": "Cor", "options": [ { "value": "classico", "label": "Azul (Clássico)" }, { "value": "arara", "label": "Verde (Arara)" } ], "default": "classico" },
    { "type": "range", "id": "qtd", "label": "Quantidade inicial (grão)", "min": 0, "max": 5, "step": 1, "default": 0 }
  ]}],
  "max_blocks": 4,
  "presets": [ { "name": "Montador da assinatura" } ]
}
{% endschema %}
