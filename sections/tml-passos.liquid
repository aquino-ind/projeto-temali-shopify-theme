<div class="tml">
  <section id="como-funciona">
    <div class="wrap">
      <div class="centro reveal">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.titulo }}</h2>
      </div>
      <ol class="passos reveal">
        {%- comment -%} modo: um passo pode valer só com a assinatura pelo site ligada (online) ou só desligada (WhatsApp); a numeração de cada modo é própria {%- endcomment -%}
        {%- assign nw = 0 -%}{%- assign no = 0 -%}
        {%- for block in section.blocks -%}
          {%- assign modo = block.settings.modo | default: 'sempre' -%}
          {%- unless modo == 'online' -%}{%- assign nw = nw | plus: 1 -%}{%- endunless -%}
          {%- unless modo == 'whatsapp' -%}{%- assign no = no | plus: 1 -%}{%- endunless -%}
          <li {{ block.shopify_attributes }}{% if modo == 'whatsapp' %} class="so-whats"{% elsif modo == 'online' %} class="so-online"{% endif %}><b>{%- if modo == 'whatsapp' -%}{{ nw }}{%- elsif modo == 'online' -%}{{ no }}{%- elsif nw == no -%}{{ nw }}{%- else -%}<span class="so-whats">{{ nw }}</span><span class="so-online">{{ no }}</span>{%- endif -%}</b><h3>{{ block.settings.titulo }}</h3><p>{{ block.settings.texto }}</p></li>
        {%- endfor -%}
      </ol>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "T • Passo a passo",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Como funciona" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Quatro passos, e o café não acaba mais" }
  ],
  "blocks": [ { "type": "passo", "name": "Passo", "settings": [
    { "type": "text", "id": "titulo", "label": "Título" },
    { "type": "textarea", "id": "texto", "label": "Texto" },
    { "type": "select", "id": "modo", "label": "Mostrar", "options": [ { "value": "sempre", "label": "Sempre" }, { "value": "whatsapp", "label": "Só com a assinatura pelo WhatsApp" }, { "value": "online", "label": "Só com a assinatura pelo site (cartão)" } ], "default": "sempre", "info": "A assinatura pelo site é ligada no Temalli CRM." }
  ]}],
  "max_blocks": 6,
  "presets": [ { "name": "T • Passo a passo" } ]
}
{% endschema %}
